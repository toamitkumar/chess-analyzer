# Environment variables for Docker Chess Analyzer
# Copy this to .env and fill in your Supabase credentials

# === Supabase Auth (Required) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# === Database (Optional - for production PostgreSQL) ===
# Leave empty to use SQLite (default)
# DATABASE_URL=postgresql://user:password@host:port/chess_analyzer

# === Application Settings ===
NODE_ENV=production
PORT=3000
