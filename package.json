{
  "name": "chesspulse",
  "version": "1.0.0",
  "description": "ChessPulse - Track your chess performance, analyze games, and improve with AI-powered insights",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/api/api-server.js",
    "analyze": "node src/models/analyzer.js",
    "dashboard": "node src/api/api-server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:clean": "rm -f data/chess_analysis_test.db data/test_*.db tests/data/*.db",
    "build:frontend": "cd frontend && npm run build",
    "build": "cd frontend && npm install && npm run build",
    "electron:dev": "electron .",
    "prepare-stockfish": "node scripts/prepare-stockfish.js",
    "electron:build": "npm run prepare-stockfish && npm run build && electron-builder --mac",
    "electron:build:dir": "npm run prepare-stockfish && npm run build && electron-builder --mac --dir",
    "dmg": "npm run electron:build",
    "release": "npm run prepare-stockfish && npm run build && electron-builder --mac --publish always",
    "download-puzzles": "node scripts/download-lichess-puzzles.js",
    "import-puzzle-index": "node scripts/import-puzzle-index.js",
    "test-import": "bash scripts/test-import.sh",
    "import-production": "bash scripts/import-to-production.sh"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "axios": "^1.13.5",
    "chess.js": "^1.0.0-beta.6",
    "cli-progress": "^3.12.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "multer": "^2.0.2",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sqlite3": "^5.1.7",
    "unbzip2-stream": "^1.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "build": {
    "appId": "com.chesspulse.app",
    "productName": "ChessPulse",
    "copyright": "Copyright © 2026 ChessPulse",
    "directories": {
      "buildResources": "electron/assets",
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "!electron/bin/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "asarUnpack": [
      "src/**/*",
      "node_modules/**/*.node"
    ],
    "extraResources": [
      {
        "from": "frontend/dist/chess-analyzer",
        "to": "frontend/dist/chess-analyzer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/bin/stockfish",
        "to": "stockfish"
      }
    ],
    "afterSign": "scripts/after-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "ChessPulse ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": {
      "provider": "github",
      "owner": "toamitkumar",
      "repo": "chess-analyzer",
      "releaseType": "release"
    }
  },
  "keywords": [
    "chess",
    "pgn",
    "stockfish",
    "analysis"
  ],
  "author": "",
  "license": "MIT"
}
